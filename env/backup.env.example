# backup: database read access, age PUBLIC key, off-site bucket. The age PRIVATE key is NOT stored on the server.
DATABASE_URL=
BACKUP_AGE_RECIPIENT=age1...
BACKUP_DIR=/backups
BACKUP_S3_ENDPOINT=              # e.g. https://<account>.r2.cloudflarestorage.com (must be off-host to count as protected)
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
