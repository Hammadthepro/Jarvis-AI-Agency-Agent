# sandbox-runner: ONLY what it needs. No provider or database credentials.
JARVIS_ENV=production
SANDBOX_RUNNER_TOKEN=            # SECRET, same value as SANDBOX_RUNNER_TOKEN in app.env (openssl rand -hex 32)
SANDBOX_IMAGE=sha256:            # image ID printed by scripts/deploy.sh after building docker/qa-sandbox.Dockerfile
SANDBOX_TIMEOUT_S=300
