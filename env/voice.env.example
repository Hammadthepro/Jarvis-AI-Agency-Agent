# voice agent: the shared secret and the API URL are required. LiveKit credentials are optional here:
# if they are saved in the dashboard (Integrations > LiveKit), the agent fetches them from the API's internal
# endpoint at startup (internal network + VOICE_AGENT_SHARED_SECRET). Values set here take precedence.
VOICE_AGENT_SHARED_SECRET=       # SECRET, same value as in app.env
JARVIS_API_URL=http://api:8000
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_STT_MODEL=deepgram/nova-3
VOICE_TTS_MODEL=cartesia/sonic-2
