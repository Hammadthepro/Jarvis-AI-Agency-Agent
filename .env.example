# JARVIS: example environment. Copy to .env and fill in. See ENVIRONMENT_VARIABLES.md.
# Never commit real values.

# Core
JARVIS_ENV=local
JARVIS_LOG_LEVEL=INFO
JARVIS_ENCRYPTION_KEY=            # openssl rand -base64 32
API_CORS_ORIGINS=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:8000   # prod: VPS provider hostname or <ip>.sslip.io
CADDY_ACME_EMAIL=
SANDBOX_IMAGE=

# Database resilience and backups
DB_HEALTH_INTERVAL_S=30
DB_RECONNECT_MAX_BACKOFF_S=60
BACKUP_SCHEDULE_CRON=0 4 * * *
BACKUP_AGE_RECIPIENT=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SECRET, server only
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
DATABASE_URL=                     # postgresql+asyncpg://...  SECRET

# Dashboard (public, safe in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# Google Places API (New): the only Google Maps Platform API used. Enable only this API in Google Cloud.
# A key alone doesn't enable usage: the compliance gate (DB) must be approved.
GOOGLE_PLACES_API_KEY=
PLACES_API_BASE_URL=https://places.googleapis.com/v1
PLACES_CAP_TEXT_SEARCH_ENTERPRISE_MONTHLY=900
PLACES_CAP_TEXT_SEARCH_ENTERPRISE_DAILY=60
PLACES_CAP_TEXT_SEARCH_PRO_MONTHLY=4500
PLACES_CAP_DETAILS_ENTERPRISE_MONTHLY=100
PLACES_INCLUDE_SERVICE_AREA_DEFAULT=true
DEFAULT_MISSING_RATING_POLICY_PRESELECT=exclude

# Website verification
NO_WEBSITE_MIN_CONFIDENCE=0.8
BROKEN_SECOND_PROBE_MINUTES=10
MAX_CANDIDATE_DOMAINS=3
MAX_PROFILE_CHECKS=3
PLACES_STORE_COORDINATES=false     # Places content other than place_id is never stored
PLACES_COORDINATES_TTL_DAYS=30

# SerpApi
SERPAPI_API_KEY=
SERPAPI_CAP_MONTHLY=240
SERPAPI_CAP_HOURLY=45

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_CAP_CREDITS_MONTHLY=950
FIRECRAWL_MAX_PAGES_PER_PROSPECT=5

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=              # optional, provider-reported usage
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_BUILD=claude-sonnet-5-5
CLAUDE_MODEL_ESCALATION=claude-opus-5-5
OPUS_MAX_ESCALATIONS_PER_SITE=2
OPUS_MAX_ESCALATIONS_PER_DAY=5
SITE_MAX_COST_MICROS=2000000

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PREVIEW_PROJECT=jarvis-previews
PREVIEW_TTL_DAYS=30
EDGE_PUBLIC_BASE_URL=
EDGE_TO_API_HMAC_SECRET=

# Email: drafts need none of this. Sending stays blocked until the readiness gate passes
# (postal address attested in Settings, authenticated domain, unsubscribe endpoint).
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_SENDING_DOMAIN=
EMAIL_REPLY_TO=
UNSUBSCRIBE_SIGNING_KEY=

# LiveKit (Phase 7)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Budgets
BUDGET_DAILY_CAP_USD=5
BUDGET_MONTHLY_CAP_USD=35
BUDGET_CAMPAIGN_DEFAULT_USD=5
ALLOW_PAID_DEFAULT=false
MAX_CONCURRENT_BUILDS=1
OUTREACH_DAILY_LIMIT_DEFAULT=20
