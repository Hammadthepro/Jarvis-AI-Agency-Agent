# JARVIS local development environment (Codespaces or your machine).
#
# scripts/dev-up.sh copies this file to .env the first time (it never overwrites an existing .env).
# Every process reads the SAME repository-root .env: the API, the worker, the migration runner and the dashboard
# (VITE_* only), wherever they are started from. Real environment variables (for example Codespaces secrets)
# override values here. Never commit .env. Production uses env/*.env (see env/*.env.example and docs/OPERATIONS.md).

# ---- Core -----------------------------------------------------------------------------------------------------------
JARVIS_ENV=local
JARVIS_LOG_LEVEL=INFO

# LOCAL DEVELOPMENT ONLY: the dashboard opens without sign-in and acts as one local operator.
# The API refuses to start with this set unless JARVIS_ENV=local. Sign-in will be added for production later.
JARVIS_LOCAL_DEV_ACCESS=true

# Encrypts provider credentials saved in Integrations. Keep it stable: credentials saved with one key cannot be
# read with another. Best: store it as a Codespaces secret named JARVIS_ENCRYPTION_KEY (it then overrides this
# line). If it is empty, scripts/dev-up.sh generates one ONCE, writes it here, and never changes it again.
JARVIS_ENCRYPTION_KEY=

# ---- Database: ONE URL for the API, worker and migrations ------------------------------------------------------------
# Matches docker-compose.dev.yml (user postgres, password jarvis, database jarvis), which scripts/dev-up.sh starts.
DATABASE_URL=postgresql://postgres:jarvis@localhost:5432/jarvis

# ---- API / dashboard ---------------------------------------------------------------------------------------------------
# The dashboard calls the API through its own origin (/api, proxied by the Vite server to the API on port 8000),
# so the browser never needs the API's address and the API port can stay private in Codespaces.
VITE_API_BASE_URL=/api
API_CORS_ORIGINS=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:8000

# ---- Website QA (local development runs Playwright as a subprocess; production uses the sandbox runner) -------------
QA_RUNNER_MODE=subprocess
SITES_ARTIFACT_DIR=.jarvis/sites

# ---- Providers: leave empty and configure them in the dashboard (Integrations), or set them here --------------------
# Missing credentials show NOT_CONFIGURED; nothing is ever simulated.
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PREVIEW_PROJECT=jarvis-previews
EMAIL_PROVIDER=
RESEND_API_KEY=
UNSUBSCRIBE_SIGNING_KEY=
GOOGLE_PLACES_API_KEY=            # restricted: blocked until written approval is recorded
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Voice agent (optional; apps/voice) ----------------------------------------------------------------------------------
VOICE_AGENT_SHARED_SECRET=
JARVIS_API_URL=http://localhost:8000

# ---- Auth (deferred; not used while JARVIS_LOCAL_DEV_ACCESS=true) --------------------------------------------------
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
