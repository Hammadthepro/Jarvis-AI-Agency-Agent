# JARVIS: example environment. Copy to .env and fill in. See ENVIRONMENT_VARIABLES.md.
# Never commit real values.

# Core
JARVIS_ENV=local
JARVIS_LOG_LEVEL=INFO
JARVIS_ENCRYPTION_KEY=            # openssl rand -base64 32
API_CORS_ORIGINS=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:8000

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SECRET, server only
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
DATABASE_URL=                     # postgresql+asyncpg://...  SECRET

# Dashboard (public, safe in the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# Google Places API (New)
GOOGLE_PLACES_API_KEY=
PLACES_MAX_TEXT_SEARCH_PRO_MONTHLY=4500
PLACES_MAX_ENTERPRISE_CALLS_MONTHLY=950
PLACES_CACHE_TTL_HOURS=720

# SerpApi
SERPAPI_API_KEY=
SERPAPI_MAX_SEARCHES_MONTHLY=240
SERPAPI_MAX_PER_HOUR=45

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CREDITS_MONTHLY=950
FIRECRAWL_MAX_PAGES_PER_PROSPECT=5

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REASONING=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_OUTREACH=claude-opus-5-5
SITE_MAX_COST_MICROS=4000000

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PREVIEW_PROJECT=jarvis-previews
PREVIEW_TTL_DAYS=30

# Email (sending blocked until a sending domain is configured)
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_SENDING_DOMAIN=
EMAIL_REPLY_TO=
UNSUBSCRIBE_SIGNING_KEY=

# LiveKit (Phase 7)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Budgets
BUDGET_DAILY_CAP_USD=5
BUDGET_MONTHLY_CAP_USD=50
BUDGET_CAMPAIGN_DEFAULT_USD=10
MAX_CONCURRENT_BUILDS=1
OUTREACH_DAILY_LIMIT_DEFAULT=20
